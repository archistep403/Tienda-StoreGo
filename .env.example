# Copia este archivo como .env y ajusta los valores:  cp .env.example .env

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=storego

# --- API ---
PORT=3001
# Clave que firma las sesiones. Cámbiala por un texto largo y aleatorio
# (en producción, con NODE_ENV=production, la API no arranca con este valor de ejemplo).
JWT_SECRET=production
NODE_ENV=production
